          "name": "[POST] Login - Success (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test 1: Check HTTP Status Code is 200",
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Test 2: Check Response Time is under 500ms",
                  "pm.test(\"Response time is less than 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "// Test 3: Validate response structure and extract Token",
                  "pm.test(\"Response returns success and valid token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.message).to.eql(\"Login successful\");",
                  "    pm.expect(jsonData.data).to.have.property(\"token\");",
                  "    pm.expect(jsonData.data.user.username).to.eql(\"student\");",
                  "",
                  "    // Save token to collection variable for subsequent requests",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    if (pm.environment) {",
                  "        pm.environment.set(\"token\", jsonData.data.token);",
                  "    }",
                  "    console.log(\"Saved auth token:\", jsonData.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
